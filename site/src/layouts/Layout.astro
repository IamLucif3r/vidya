---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = "A personal daily knowledge log." } = Astro.props;
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base.replace(/\/$/, "")}/${path.replace(/^\//, "")}`;
const pageTitle = title ? `${title} · vidya` : "vidya";

const nav = [
  { href: withBase("/"), label: "Dashboard" },
  { href: withBase("/timeline"), label: "Timeline" },
  { href: withBase("/tags"), label: "Tags" },
  { href: withBase("/search"), label: "Search" },
];

const current = Astro.url.pathname.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Code+Pro:ital,wght@0,200..900;1,200..900&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    <script is:inline>
      // Set theme before paint to avoid a flash of the wrong theme.
      (() => {
        const stored = localStorage.getItem("theme");
        const theme =
          stored ||
          (window.matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark");
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a class="brand" href={withBase("/")}><span class="brand-mark">विद्या</span> vidya</a>
        <nav class="nav">
          {
            nav.map((item) => {
              const itemPath = item.href.replace(/\/$/, "");
              const isCurrent = itemPath === current;
              return (
                <a href={item.href} aria-current={isCurrent ? "page" : undefined}>
                  {item.label}
                </a>
              );
            })
          }
          <button
            id="theme-toggle"
            class="theme-toggle"
            type="button"
            aria-label="Toggle dark and light theme"
            title="Toggle theme"
          >
            <span aria-hidden="true"></span>
          </button>
        </nav>
      </div>
    </header>
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="container">
        vidya · @IamLucif3r · Powered by Astro
      </div>
    </footer>
    <script is:inline>
      (() => {
        const btn = document.getElementById("theme-toggle");
        const icon = btn?.querySelector("span");
        const setIcon = (theme) => {
          if (icon) icon.textContent = theme === "light" ? "☾" : "☼";
        };
        setIcon(document.documentElement.dataset.theme);
        btn?.addEventListener("click", () => {
          const next =
            document.documentElement.dataset.theme === "light" ? "dark" : "light";
          document.documentElement.dataset.theme = next;
          localStorage.setItem("theme", next);
          setIcon(next);
        });
      })();
    </script>
  </body>
</html>
