---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base.replace(/\/$/, "")}/${path.replace(/^\//, "")}`;
// Pagefind assets are generated into the build output during `pagefind --site dist`.
const pagefindCss = withBase("/pagefind/pagefind-ui.css");
const pagefindJs = withBase("/pagefind/pagefind-ui.js");
const bundlePath = withBase("/pagefind/");
---

<Layout title="Search">
  <h1>Search</h1>
  <p class="muted">Full-text search across every entry.</p>
  <link href={pagefindCss} rel="stylesheet" />
  <div id="search" style="margin-top:1rem;"></div>
  <script is:inline define:vars={{ pagefindJs, bundlePath }}>
    window.addEventListener("DOMContentLoaded", () => {
      const start = () => {
        // eslint-disable-next-line no-undef
        new PagefindUI({ element: "#search", bundlePath, showSubResults: true });
      };
      const script = document.createElement("script");
      script.src = pagefindJs;
      script.onload = start;
      script.onerror = () => {
        document.getElementById("search").innerHTML =
          '<p class="muted">Search index not found. Run <code>npm run build</code> to generate it.</p>';
      };
      document.head.appendChild(script);
    });
  </script>
</Layout>
