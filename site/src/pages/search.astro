---
import Layout from "../layouts/Layout.astro";
import Search from "astro-pagefind/components/Search.astro";
---

<Layout title="Search">
  <h1>Search</h1>
  <p class="muted">Full-text search across every entry.</p>
  <div style="margin-top:1rem;">
    <Search id="search" className="pagefind-ui" uiOptions={{ showSubResults: true, showImages: false }} />
  </div>
  <p class="muted" style="margin-top:1rem;font-size:0.85rem;">
    Search runs on the published site and in <code>npm run preview</code>. It is
    unavailable in <code>npm run dev</code> because the index is built at build time.
  </p>
</Layout>
