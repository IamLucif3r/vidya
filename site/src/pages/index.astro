---
import Layout from "../layouts/Layout.astro";
import NoteCard from "../components/NoteCard.astro";
import {
  getNotes,
  getTagMap,
  getActivity,
  getStreak,
  excerpt,
  toLocalISO,
} from "../lib/notes";

const notes = await getNotes();
const tagMap = await getTagMap();

const dated = notes.filter((n) => n.date);
const newest = dated[0]?.date ?? null;
const oldest = dated[dated.length - 1]?.date ?? null;

const daysSpan =
  newest && oldest
    ? Math.max(1, Math.round((newest.getTime() - oldest.getTime()) / 86_400_000) + 1)
    : 0;

const streak = getStreak(notes);
const featured = notes[0] ?? null;
const featuredExcerpt = featured ? excerpt(featured) : "";

const topTags = [...tagMap.entries()].sort((a, b) => b[1].length - a[1].length);
const maxTagCount = topTags[0]?.[1].length ?? 1;

const recent = notes.slice(0, 6);

// --- Activity heatmap: last 26 weeks, aligned Sunday..Saturday ---
const WEEKS = 26;
const activity = getActivity(notes);
const maxCount = Math.max(1, ...activity.values());

const today = new Date();
today.setHours(0, 0, 0, 0);
const end = new Date(today);
end.setDate(end.getDate() + (6 - end.getDay())); // this week's Saturday
const start = new Date(end);
start.setDate(start.getDate() - (WEEKS * 7 - 1));

type Cell = { iso: string; count: number; level: number; future: boolean; label: string };
const weeks: Cell[][] = [];
const cursor = new Date(start);
for (let w = 0; w < WEEKS; w++) {
  const col: Cell[] = [];
  for (let i = 0; i < 7; i++) {
    const iso = toLocalISO(cursor);
    const count = activity.get(iso) ?? 0;
    const level = count === 0 ? 0 : Math.min(4, Math.ceil((count / maxCount) * 4));
    col.push({
      iso,
      count,
      level,
      future: cursor > today,
      label: cursor.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }),
    });
    cursor.setDate(cursor.getDate() + 1);
  }
  weeks.push(col);
}

const phrases = [
  "tracking cyber threats",
  "decoding CVEs",
  "mapping the attack surface",
  "notes to future me",
  "today I learned",
];

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base.replace(/\/$/, "")}/${path.replace(/^\//, "")}`;
---

<Layout title="Home">
  <section class="hero">
    <div class="hero-word">विद्या</div>
    <div class="typed">
      <span class="prompt">&gt;</span>
      <span id="typed-text">{phrases[0]}</span><span class="caret" aria-hidden="true">▍</span>
    </div>
    <p class="hero-sub muted">
      A daily log of facts, threats, and ideas — captured as they happen, kept for later.
    </p>
    <div class="hero-actions">
      <a class="btn" href={withBase("/timeline")}>Browse timeline</a>
      <a class="btn btn-ghost" href={withBase("/search")}>Search</a>
    </div>
  </section>

  <div class="stat-chips">
    <span class="chip"><b>{notes.length}</b> entries</span>
    <span class="chip"><b>{tagMap.size}</b> tags</span>
    <span class="chip"><b>{daysSpan}</b> day span</span>
    <span class="chip"><b>{streak}</b> day streak</span>
  </div>

  {
    featured && (
      <a class="featured" href={withBase(`/notes/${featured.slug}`)}>
        <div class="featured-label">Latest entry</div>
        <h2 class="featured-title">{featured.title}</h2>
        <div class="featured-date muted">{featured.displayDate}</div>
        {featuredExcerpt && <p class="featured-excerpt">{featuredExcerpt}</p>}
        {featured.tags.length > 0 && (
          <div class="tags">
            {featured.tags.map((tag) => (
              <span class="tag">#{tag}</span>
            ))}
          </div>
        )}
        <span class="featured-cta">Read →</span>
      </a>
    )
  }

  <section class="panel">
    <div class="panel-head">
      <h2>Activity</h2>
      <span class="muted">last {WEEKS} weeks</span>
    </div>
    <div class="heatmap" role="img" aria-label="Entries per day over the last 26 weeks">
      {
        weeks.map((col) => (
          <div class="heat-col">
            {col.map((cell) => (
              <span
                class:list={["heat-cell", { future: cell.future }]}
                data-level={cell.level}
                title={cell.future ? cell.label : `${cell.count} ${cell.count === 1 ? "entry" : "entries"} · ${cell.label}`}
              />
            ))}
          </div>
        ))
      }
    </div>
    <div class="heat-legend muted">
      <span>less</span>
      <span class="heat-cell" data-level="0"></span>
      <span class="heat-cell" data-level="1"></span>
      <span class="heat-cell" data-level="2"></span>
      <span class="heat-cell" data-level="3"></span>
      <span class="heat-cell" data-level="4"></span>
      <span>more</span>
    </div>
  </section>

  {
    topTags.length > 0 && (
      <section class="panel">
        <div class="panel-head">
          <h2>Explore by tag</h2>
          <a class="muted" href={withBase("/tags")}>all tags →</a>
        </div>
        <div class="tag-cloud">
          {topTags.slice(0, 24).map(([tag, list]) => {
            const scale = 0.85 + (list.length / maxTagCount) * 0.9;
            return (
              <a
                class="cloud-tag"
                href={withBase(`/tags/${encodeURIComponent(tag)}`)}
                style={`font-size:${scale.toFixed(2)}rem`}
              >
                #{tag}
              </a>
            );
          })}
        </div>
      </section>
    )
  }

  <section class="panel">
    <div class="panel-head">
      <h2>Recent entries</h2>
      <a class="muted" href={withBase("/timeline")}>timeline →</a>
    </div>
    {
      recent.length > 0 ? (
        <ul class="note-list">
          {recent.map((note) => (
            <NoteCard note={note} />
          ))}
        </ul>
      ) : (
        <p class="muted">
          No notes found under <code>raw/</code> yet.
        </p>
      )
    }
  </section>

  <script is:inline define:vars={{ phrases }}>
    (() => {
      const el = document.getElementById("typed-text");
      if (!el || !Array.isArray(phrases) || phrases.length === 0) return;
      let p = 0;
      let i = 0;
      let deleting = false;
      const tick = () => {
        const word = phrases[p];
        i += deleting ? -1 : 1;
        el.textContent = word.slice(0, i);
        let delay = deleting ? 45 : 90;
        if (!deleting && i === word.length) {
          delay = 1600;
          deleting = true;
        } else if (deleting && i === 0) {
          deleting = false;
          p = (p + 1) % phrases.length;
          delay = 350;
        }
        setTimeout(tick, delay);
      };
      setTimeout(tick, 900);
    })();
  </script>
</Layout>

